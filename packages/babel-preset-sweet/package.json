{
  "name": "@sweet-milktea/babel-preset-sweet",
  "version": "4.6.0",
  "description": "babel插件",
  "homepage": "https://github.com/duan602728596/sweet",
  "repository": {
    "type": "git",
    "url": "git@github.com:duan602728596/sweet.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "build:esm:0": "tsc --outDir dist/esm --skipLibCheck",
    "build:types:0": "tsc --outDir dist/types --declaration --emitDeclarationOnly --skipLibCheck",
    "build:1": "node --run build:esm:0 && node --run build:types:0",
    "test": "node test/test.ts"
  },
  "dependencies": {
    "@babel/plugin-proposal-async-do-expressions": "^8.0.1",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/plugin-proposal-destructuring-private": "^8.0.5",
    "@babel/plugin-proposal-do-expressions": "^8.0.1",
    "@babel/plugin-proposal-export-default-from": "^8.0.1",
    "@babel/plugin-proposal-function-bind": "^8.0.1",
    "@babel/plugin-proposal-pipeline-operator": "^8.0.1",
    "@babel/plugin-proposal-throw-expressions": "^8.0.1",
    "@babel/plugin-transform-class-properties": "^8.0.1",
    "@babel/plugin-transform-explicit-resource-management": "^8.0.5",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/preset-env": "^8.0.5",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@babel/runtime": "^8.0.5",
    "@babel/runtime-corejs3": "^8.0.5",
    "babel-plugin-polyfill-corejs3": "^0.14.2",
    "core-js": "^3.50.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "cross-env": "*",
    "typescript": "^7.0.2"
  }
}
