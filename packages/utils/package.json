{
  "name": "@sweet-milktea/utils",
  "version": "4.0.0",
  "homepage": "https://github.com/duan602728596/sweet",
  "repository": {
    "type": "git",
    "url": "git@github.com:duan602728596/sweet.git"
  },
  "main": "index.cjs",
  "exports": {
    ".": {
      "import": {
        "types": [
          "./esm/index.d.mts"
        ],
        "default": "./esm/index.mjs"
      },
      "require": {
        "types": [
          "./cjs/index.d.cts"
        ],
        "default": "./cjs/index.cjs"
      }
    }
  },
  "scripts": {
    "build:esm": "tsc --outDir esm --skipLibCheck",
    "build:cjs": "tsc --outDir cjs --module Node16 --moduleResolution Node16 --project tsconfig.cjs.json --skipLibCheck",
    "test": "cross-env NODE_ENV=test mocha test/test.mjs --timeout 180000"
  },
  "devDependencies": {
    "cross-env": "*",
    "mocha": "*",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=16"
  }
}
